# OpenAI 兼容接口。换模型只改这里，不要把真实密钥提交到仓库。
LLM_BASE_URL=https://token.iflink.tech/v1
LLM_MODEL=deepseek-v4.1-flash-1017
LLM_API_KEY=

# 1 = 不调用大模型，全程走离线规则智能体（比赛断网演练）
DEMO_MODE=0

# 页面公示位：模型名称与备案号。上线前替换为真实公示文案。
MODEL_NOTICE=模型名称与备案号：上线前公示

PORT=3000
HOST=0.0.0.0

# 部署在反向代理后面（Render 会自动识别）时设为 1，限流才能按真实访客 IP 计数。
# 直接对外暴露时不要设：否则任何人都能伪造 X-Forwarded-For 绕过限流。
TRUST_PROXY=0

# 可选：服务端语音识别 / 朗读（任何兼容 OpenAI 语音接口的服务）。不填则使用浏览器自带能力，再不行退回打字。
# 这些服务通常按量收费，开通前请确认费用。
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
